# Supabase project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only key: never ship this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

PORT=10001
NODE_ENV=development
# Comma-separated mobile/web origins. Use * only for local prototyping.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
# Required only if the protected HTTP crawl trigger is used.
CRON_SECRET=replace-with-a-long-random-secret
# Optional source that returns { "snapshots": [{ productId, price, source, capturedAt? }] }.
PRICE_FEED_URL=
