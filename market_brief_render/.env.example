# Supabase project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only key: never ship this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

PORT=10001
NODE_ENV=development
# Comma-separated mobile/web origins. Use * only for local prototyping.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
# The account ID that should open the in-app administrator dashboard after sign-in.
ADMIN_LOGIN_ID=your-admin-id
# Generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
ADMIN_SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
# Required only if the protected HTTP crawl trigger is used.
CRON_SECRET=replace-with-a-long-random-secret
# Legacy optional source that returns { "prices": [{ ramName, price, source, weekStart? }] }.
PRICE_FEED_URL=

# Licensed market-data feeds only. Do not point these at shopping pages or use
# browser automation. Each provider must return:
# { "authorization": { "approved": true, "reference": "<same reference>" },
#   "observations": [{ "ramGeneration":"DDR5", "capacityGb":32, "clockMhz":6000,
#     "price":123000, "sourceProductId":"provider-id", "sourceProductName":"..." }] }
# The job refuses to run a provider until its own approval flag and contract/API
# reference are set. Keep tokens server-side only.
NAVER_SHOPPING_PROVIDER_URL=
NAVER_SHOPPING_PROVIDER_TOKEN=
NAVER_SHOPPING_DATA_LICENSE_APPROVED=false
NAVER_SHOPPING_DATA_LICENSE_REFERENCE=
DANAWA_RESEARCH_PROVIDER_URL=
DANAWA_RESEARCH_PROVIDER_TOKEN=
DANAWA_RESEARCH_DATA_LICENSE_APPROVED=false
DANAWA_RESEARCH_DATA_LICENSE_REFERENCE=
